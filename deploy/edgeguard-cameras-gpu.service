[Unit]
Description=EdgeGuard AI - Camera Service (RTSP, TensorRT GPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pparkitn
WorkingDirectory=/home/pparkitn/edgeguard
EnvironmentFile=/home/pparkitn/edgeguard/cameras.env
ExecStart=/home/pparkitn/py38env/bin/python -m jetson_gpu.main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target